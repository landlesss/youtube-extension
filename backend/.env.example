# Server
PORT=8787
NODE_ENV=development
CORS_ORIGIN=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Postgres (Neon / Supabase connection string, requires sslmode=require in production)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google OAuth (same client used by the extension's manifest.json "oauth2.client_id")
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Session JWT
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d

# Translation provider: "deepl" | "google"
TRANSLATE_PROVIDER=deepl
DEEPL_API_KEY=REPLACE_WITH_DEEPL_KEY
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
GOOGLE_TRANSLATE_API_KEY=REPLACE_WITH_GOOGLE_TRANSLATE_KEY

# Paddle
PADDLE_API_KEY=REPLACE_WITH_PADDLE_API_KEY
PADDLE_WEBHOOK_SECRET=REPLACE_WITH_PADDLE_WEBHOOK_SECRET
